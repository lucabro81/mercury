{
  "name": "@mercury-fw/plugin-jira",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucabro81/mercury-fw.git",
    "directory": "packages/tools/plugin-jira"
  },
  "files": [
    "*.ts",
    "jira.json",
    "scripts",
    "skills",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "postinstall": "bun run scripts/install-jira-cli.ts",
    "test": "bun test"
  },
  "mercury": {
    "cliBinary": {
      "repo": "lucabro81/CLI-monorepo",
      "crate": "jira",
      "version": "0.8.0"
    }
  },
  "dependencies": {
    "ai": "^7.0.77",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mercury-fw/cli-engine": ">=0.24.0 <1.0.0",
    "@mercury-fw/plugin-types": ">=0.24.0 <1.0.0",
    "@mercury-fw/utils": ">=0.24.0 <1.0.0"
  },
  "devDependencies": {
    "@mercury-fw/cli-engine": "workspace:*",
    "@mercury-fw/plugin-types": "workspace:*",
    "@mercury-fw/utils": "workspace:*"
  }
}
