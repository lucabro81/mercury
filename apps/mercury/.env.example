# Which CLI plugins to enable on this instance, comma-separated plugin names
# (each must also be declared in mercury.config.ts). Editing this requires a
# rebuild (docker compose build) and a restart — a maintainer decision, not
# Mercury's. Each plugin owns its allowlist and pinned CLI binary; there is no
# separate config directory to populate.
MERCURY_CLIS=jira,bitbucket,atlassian-admin

# Which channel plugins to enable, comma-separated channel names (each must
# also be declared in mercury.config.ts). Google Chat is one; a channel with
# no config on this instance (e.g. no GOOGLE_CHAT_PUBSUB_SUBSCRIPTION below)
# stays inert even when enabled. Terminal and HTTP are always wired directly.
MERCURY_CHANNELS=google-chat

# Optional, one per CLI: base64-encoded tar of ~/.config/<cli-name>, for a
# CLI whose auth isn't available via a host bind mount (e.g. a deployment
# without a live host installation of that CLI). Used only once, by
# scripts/docker-entrypoint.sh, to seed the (empty) cli-credentials named
# volume before Mercury starts — if that CLI's folder already exists on
# the volume (e.g. from a previous run, possibly with a refreshed token),
# this is ignored, never overwritten. Leave unset if that CLI's config is
# provided another way (e.g. docker-compose.override.yml's host bind mount
# in dev — the default on the maintainer's own machine).
# Generate on a machine that already has valid credentials with:
#   tar czf - -C ~/.config <cli-name> | base64
JIRA_CLI_CONFIG_TAR_B64=
BITBUCKET_CLI_CONFIG_TAR_B64=
ATLASSIAN_ADMIN_CLI_CONFIG_TAR_B64=

# Comperio's browsable Jira site (e.g. https://webcomperio.atlassian.net),
# used only to build a clickable link per issue in a formatted issue list.
# Not derivable from any jira-cli output — the API talks to
# api.atlassian.com/ex/jira/<cloud-id>/..., unrelated to this hostname.
# Leave unset to skip issue-list formatting entirely (runCommand's result
# for issue search is then returned unaugmented, as before).
JIRA_SITE_URL=

# Optional: override how each issue line is rendered in a formatted issue
# list. Placeholders {key} {status} {summary} {url} are substituted; a
# missing status becomes an empty string. Leave unset (or empty) for the
# default format ("{key} [{status}] {summary}" with the browse link on the
# next line, and no bracket at all when status is absent). Read where the
# issue-list render handler is wired (mercury.config.ts), not by the plugin.
# JIRA_ISSUE_LIST_TEMPLATE=

# Ollama-compatible endpoint — never hardcoded in the code.
# Default for development on this machine (macOS + Docker Desktop, local Ollama):
OLLAMA_HOST=http://host.docker.internal:11434

# Which model to request from the endpoint above — never hardcoded either,
# since the production target (a larger model) can't run on every dev machine.
# Suggested default for this machine (already pulled locally):
OLLAMA_MODEL=qwen3:14b

# Whether to request Ollama's native extended-thinking tokens — most models
# Mercury has run against support it, so this defaults to on. Set to
# "false" only for a model that doesn't (Ollama then rejects every request
# outright with "<model> does not support thinking", not a silent no-op).
OLLAMA_THINK=true

QDRANT_URL=http://qdrant:6333

# Wiki vault (Layer 2) — its own git repo, mounted as the
# `wiki-vault` named volume in docker-compose.yml. Default matches that
# mount; only change this if the volume is mounted somewhere else.
WIKI_VAULT_PATH=/app/wiki-vault

# Session persistence (Layer 3). A Google Chat session idle past
# SESSION_IDLE_TIMEOUT_MS (ms) is summarized and written to Qdrant, then its
# raw transcript is discarded. SESSION_IDLE_CHECK_INTERVAL_MS controls how
# often the cron scans for idle sessions — must stay well under the timeout
# itself, or a session could sit idle for a while past the threshold before
# ever being checked. Never applies to the terminal channel (a single-
# operator debug surface, not a real multi-user one).
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_IDLE_CHECK_INTERVAL_MS=60000

# Embedding model for Layer 3, already on GB10 via Ollama.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant collection for episodic memory and its vector size — must
# match OLLAMA_EMBEDDING_MODEL's actual output dimension (768 for
# nomic-embed-text); change both together if the embedding model changes.
QDRANT_EPISODIC_COLLECTION=episodic_memory
QDRANT_EPISODIC_VECTOR_SIZE=768

# Google Chat — registered app, its own bot identity (not a Workspace-user
# impersonation): no domain-wide delegation, no admin action needed. These
# are the app's own service-account credentials (client_email/private_key
# from its JSON key), used to mint a chat.bot + pubsub scoped OAuth2 token
# directly (see @mercury/channel-google-chat) — never a
# file path, never read by a CLI subprocess.
GOOGLE_CHAT_APP_CLIENT_EMAIL=
GOOGLE_CHAT_APP_PRIVATE_KEY=

# Pub/Sub pull subscription backing the app's Cloud Pub/Sub deployment
# (full resource name, "projects/<project>/subscriptions/<sub>"). A single
# subscription for the whole app — no per-space subscriptions, whatever
# space the app is a member of delivers its events here. Leave empty to
# disable the channel entirely — Mercury then only runs the terminal channel.
GOOGLE_CHAT_PUBSUB_SUBSCRIPTION=

# GitHub API (Extension Capability Loop — Mercury opens an issue for a
# capability gate it can't do via CLI, reviewed by a human before anything
# gets implemented)
GITHUB_TOKEN=

# Admin panel (POC, throwaway — see src/admin/). Disabled by default; set to
# "true" to start it. Dev-only, unauthenticated by design — never enable
# outside a local machine. Requires docker-compose.override.yml's bind mount
# of the real .env file (not just env_file's injected values) to be present.
ADMIN_PANEL_ENABLED=false
ADMIN_PANEL_PORT=4000

# HTTP surface (see src/http/, ARCHITECTURE.md "HTTP surface"). Disabled by
# default; set to "true" to start it. No authentication by design — same
# posture as the admin panel above: opt-in, and never expose the port outside
# the container network. Exposes a conversational endpoint (POST /turn,
# Server-Sent Events); read-only introspection routes land here later.
HTTP_SURFACE_ENABLED=false
HTTP_SURFACE_PORT=4100

# HTTP surface: allowed CORS origin for a browser UI on another origin.
# Default "*" (no credentials are used). Set to a specific origin to pin it.
HTTP_SURFACE_CORS_ORIGIN=*
