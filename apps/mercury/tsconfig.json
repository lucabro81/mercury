{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // The Jira plugin ships its allowlist as a JSON asset that its index.ts
    // imports (packages/plugin-jira); typechecking that import needs this.
    // Kept here rather than in the shared base so it stays scoped to the app
    // that actually resolves the plugin's sources.
    "resolveJsonModule": true
  }
}
