services:
  mercury:
    build: .
    # Back up after a crash or a host reboot.
    restart: unless-stopped
    env_file:
      - path: .env
        required: false
    volumes:
      - wiki-vault:/app/wiki-vault
      # The tool plugins' CLI credentials, on a volume so what a CLI writes back
      # (refreshed tokens) survives a redeploy. docker-entrypoint.sh fills it: see README.md.
      - cli-credentials:/home/mercury/.config
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - qdrant

  qdrant:
    image: qdrant/qdrant:v1
    volumes:
      - qdrant-data:/qdrant/storage

volumes:
  wiki-vault:
    name: demo_wiki-vault
  qdrant-data:
    name: demo_qdrant-data
  cli-credentials:
    name: demo_cli-credentials
