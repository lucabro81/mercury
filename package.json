{
  "name": "mercury-monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucabro81/mercury-fw.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "release": "changeset version && bash scripts/tag-release.sh"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/types/*",
    "packages/channels/*",
    "packages/tools/*",
    "packages/formatters/*",
    "packages/libs/*",
    "packages/config/*"
  ]
}
