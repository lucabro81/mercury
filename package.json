{
  "name": "mercury-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "release": "changeset version && bash scripts/tag-release.sh"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
