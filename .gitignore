# Local/private docs (not for the repo). `docs` is unanchored on purpose:
# the private design docs travel with whichever workspace owns them, so this
# has to match at any depth, not just the root.
docs
CLAUDE.local.md
.claude/settings.local.json
.claude/current-scope.md
.claude/hooks/

# Dependencies
node_modules

# Turborepo
.turbo

# Bun — bun.lock (text) IS committed; bun.lockb (binary) is not
bun.lockb

# Build output
dist
build
out

# CLI binaries downloaded at image-build time (scripts/install-clis.sh)
bin

# Env — .env.example is the only one that ships
.env
.env.*
!.env.example

# Benchmark run output — regenerated by run.ts, disposable (see
# clear-results.ts); the zip is the actual backup, not this dir or git.
# Unanchored so it holds wherever the harness ends up living in the monorepo.
**/benchmark/results/
**/benchmark/results-*.zip

# Volumes / persisted data (Qdrant, wiki vault, etc.)
data
volumes

# Logs
*.log
logs

# OS / editor
.DS_Store
*.pem
.vscode
.idea
coverage
